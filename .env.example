# Application
PROJECT_NAME="Sentinel-AI"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Database (PostgreSQL 16 + pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_secure_pass
POSTGRES_DB=sentinel_db

# Asynchronous Database URL
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel_secure_pass@localhost:5432/sentinel_db

# Security & CORS
SECRET_KEY=change_me_to_a_secure_random_key_in_production
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Embedding & NLP Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# LLM Providers (Optional / Fallback)
OPENAI_API_KEY=
GEMINI_API_KEY=
